# Breach monitoring (Phase 2+)
HIBP_API_KEY=
DEHASHED_API_KEY=
DEHASHED_EMAIL=

# CAPTCHA solving (Phase 3+)
CAPTCHA_API_KEY=

# Email for removal requests (Phase 3+)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# IMAP: the inbox that receives broker "confirm your removal" emails. The
# scheduler's process_confirmations job polls it, matches messages to pending
# removals, and (if DIGITAL_FOOTPRINT_AUTO_CONFIRM=1) visits the confirmation
# link — only ever on the broker's own domain. Use a dedicated inbox.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Auto-click broker confirmation links (off by default: the link is recorded
# on the removal for you to click).
DIGITAL_FOOTPRINT_AUTO_CONFIRM=

# Optional
DIGITAL_FOOTPRINT_DB_PATH=~/.digital-footprint/footprint.db

# Encryption at rest for PII (names, emails, phones, addresses, finding URLs).
# Off by default (the DB is plaintext and logs a warning). Turn it on either
# way:
#   1. DIGITAL_FOOTPRINT_ENCRYPT=1 — generates/loads a key file next to the DB
#      (db.key, chmod 600). Simplest; keep that file safe (losing it = data
#      is unrecoverable).
#   2. DIGITAL_FOOTPRINT_DB_KEY=<fernet key> — bring your own key. Generate:
#      python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To encrypt an existing plaintext DB, enable one of the above, then run the
# migration (Database.migrate_to_encrypted()).
DIGITAL_FOOTPRINT_ENCRYPT=
DIGITAL_FOOTPRINT_DB_KEY=
